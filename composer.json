{
    "name": "monkeyscloud/monkeyslegion-notifications",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\Notifications\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "require-dev": {
        "phpunit/phpunit": "^13.1@dev",
        "phpstan/phpstan": "2.2.x-dev",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "require": {
        "monkeyscloud/monkeyslegion-cli": "^2.1",
        "monkeyscloud/monkeyslegion-core": "^2.1",
        "monkeyscloud/monkeyslegion-di": "^2.0",
        "monkeyscloud/monkeyslegion-events": "^2.0",
        "monkeyscloud/monkeyslegion-mail": "^2.0",
        "monkeyscloud/monkeyslegion-mlc": "^3.2",
        "monkeyscloud/monkeyslegion-query": "^2.1",
        "monkeyscloud/monkeyslegion-queue": "^2.0",
        "monkeyscloud/monkeyslegion-template": "^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "extra": {
        "monkeyslegion": {
            "providers": [
                "MonkeysLegion\\Notifications\\Providers\\NotificationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=max",
        "cs-fix": "php-cs-fixer fix src",
        "ci": [
            "@analyse",
            "@test"
        ]
    }
}
